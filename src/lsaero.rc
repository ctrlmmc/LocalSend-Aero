#include <windows.h>

#define IDR_MANIFEST 1

IDR_MANIFEST RT_MANIFEST "app.manifest"

// Application icon (Explorer, shortcuts, Alt+Tab). Paths are resolved relative
// to this .rc file, so the assets can live outside src\.
IDI_APP ICON "../icons/lsaero.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 0,1,0,0
 PRODUCTVERSION 0,1,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "LocalSend Aero"
            VALUE "FileDescription", "LocalSend Aero"
            VALUE "FileVersion", "0.1.0.0"
            VALUE "InternalName", "lsaero"
            VALUE "OriginalFilename", "lsaero.exe"
            VALUE "ProductName", "LocalSend Aero"
            VALUE "ProductVersion", "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
